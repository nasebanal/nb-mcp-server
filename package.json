{
  "name": "nb-mcp-server",
  "version": "0.1.0",
  "description": "Remote MCP server exposing NASEBANAL Target and Recorder data to MCP clients (Claude Desktop, etc.) via Auth0 OAuth login.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8791 --inspector-port 0",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "cf-typegen": "wrangler types",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "mcp",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nasebanal/sdk": "^0.1.1",
    "agents": "^0.22.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "undici": "^8.0.0",
    "sharp": "0.35.4",
    "postcss": "^8.5.18",
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4",
    "brace-expansion@4.0.0 - 5.0.8": "5.0.9",
    "nanoid@<3.3.17": "3.3.18"
  }
}
